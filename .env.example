# Copia este archivo a ".env" y completa tus valores reales.
# ".env" está en .gitignore y nunca debe subirse a un repositorio.
# ESTE ARCHIVO ES UNA PLANTILLA: nunca pongas claves reales aquí.

# API key gratuita de OpenTopography (https://portal.opentopography.org)
# Necesaria para descargar el DEM (Copernicus GLO-30 / SRTM).
OPENTOPOGRAPHY_API_KEY=

# Opcional: si más adelante se usa Cesium ion en vez de terreno self-hosted.
CESIUM_ION_TOKEN=

# API key de Anthropic (https://console.anthropic.com) para el asesor IA de
# alertas de inundación (/api/ai_analysis). Cada análisis es una llamada real
# al modelo (con caché de 15 min en el backend).
ANTHROPIC_API_KEY=

# Opcional: modelo a usar para el asesor (default: claude-opus-4-8)
# AI_ADVISOR_MODEL=claude-opus-4-8

# Detrás de un proxy (ALB, CloudFront, nginx): sin esto todos los usuarios comparten
# la IP del proxy y el rate limit es global; con X-Forwarded-For sin más, se falsifica.
# TRUST_PROXY=1
# Número de proxies confiables que añaden su entrada a X-Forwarded-For
# (1 = ALB; 2 = CloudFront + ALB). Se cuenta desde la derecha.
# TRUSTED_PROXY_HOPS=1
